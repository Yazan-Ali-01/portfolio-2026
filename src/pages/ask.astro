---
import Story from '../layouts/Story.astro';
import Ask from '../components/Ask.tsx';
import WorldSwitch from '../components/WorldSwitch.astro';
import { about } from '../content/about';
import { meta } from '../content/meta';

/**
 * Ask about Yazan (E12).
 *
 * A third way in, next to the story and the work: the visitor asks, and
 * something that knows him answers. It is not him, and the page says so
 * before the first question rather than after.
 *
 * Only the ids that have somewhere to go are sent to the client. The rest of
 * the corpus never leaves the server: the answers come from it, the page does
 * not ship it.
 */
/*
 * The whole record goes to the client, text included.
 *
 * It did not, at first, on the principle that the answers come from it and the
 * page need not ship it. That was the wrong call: the point of this page is
 * that every claim is checkable, and a citation you cannot open is a citation
 * you have to take on trust. Ten kilobytes buys a reader the ability to audit
 * any sentence against the exact line it came from, which is the whole
 * argument the page is making.
 */
const facts = Object.fromEntries(
  about.map((f) => [
    f.id,
    { topic: f.topic, text: f.text, label: f.source?.label, href: f.source?.href },
  ]),
);

const openers = [
  'What has he actually built?',
  'Is he any good at backend, or is he a frontend engineer?',
  'What is he not good at?',
  'Has he led a team?',
];
---

<Story
  world="work"
  title={`Ask about Yazan — ${meta.name}`}
  description="Ask questions about Yazan Ali's work and get answers from something that knows it, with a link to where each answer came from."
  noindex
>
  <div class="asking u-shell--story">
    <WorldSwitch current="work" />

    <header class="asking__top">
      <h1 class="asking__head">Ask about him</h1>
      <p class="asking__lede">
        Not Yazan. Someone who knows his work, answering from a fixed record of
        {' '}{about.length} facts. Every claim is numbered and says which one it came from,
        including the parts that are not flattering.
      </p>
    </header>

    <Ask facts={facts} total={about.length} openers={openers} client:load />

    <p class="asking__small">
      Answers are generated by a model from a fixed set of facts about him. It gets things
      wrong sometimes, it will not discuss money or visas, and conversations are kept so he
      can see what people wanted to know. For anything that matters, email{' '}
      <a href={`mailto:${meta.email}`}>{meta.email}</a>.
    </p>
  </div>
</Story>

<style>
  /*
   * A fixed height, not a minimum. The conversation scrolls inside its own log
   * and the input stays on screen; with min-height the page grew instead and
   * the thing you type into walked off the bottom.
   */
  /*
   * Wide: a fixed height so the transcript scrolls inside itself and the margin
   * stays put. Narrow: the page grows and scrolls as a page.
   */
  .asking {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-md) var(--space-lg);
    gap: var(--space-md);
  }

  .asking__top {
    max-width: 34rem;
  }

  @media (min-width: 62rem) {
    .asking {
      height: 100svh;
    }
  }

  .asking__head {
    font-size: clamp(1.9rem, 1.1rem + 2.4vw, 2.9rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-xs);
  }

  .asking__lede {
    color: var(--ink-muted);
    margin: 0;
  }

  .asking__small {
    max-width: 38rem;
    margin: 0;
    font-family: var(--face-meta);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .asking__small a {
    color: var(--ink-muted);
  }
</style>
