---
import Story from '../../layouts/Story.astro';
import Studio from '../../components/Studio.tsx';
import WorldSwitch from '../../components/WorldSwitch.astro';
import { projects } from '../../content/projects';
import { deskNotes } from '../../content/desk-notes';
import { meta } from '../../content/meta';

/**
 * Placement in the room. The diagram is pinned to the wall the way an architect
 * pins a drawing; the two products stand on the desk. Aspects match the textures
 * generated by tools/textures.mjs, so nothing is stretched.
 */
const artifacts = [
  { id: 'complytude', name: 'Complytude', texture: '/work/tex/complytude.jpg', place: 'wall' as const, x: 2.2, width: 3.3, aspect: 452 / 1024 },
  { id: 'driven', name: 'Driven Properties', texture: '/work/tex/driven.jpg', place: 'desk' as const, x: -1.6, width: 3.0, aspect: 640 / 1024 },
  { id: 'jeem', name: 'Jeem', texture: '/work/tex/jeem.jpg', place: 'desk' as const, x: 1.5, width: 2.4, aspect: 592 / 1024 },
];

/**
 * The studio's ground floor. E10 mounts the 3D room on top of this; the list
 * below is what remains with JavaScript disabled, and it is never removed —
 * every project has to be reachable without the scene.
 */
---

<Story
  world="work"
  title={`Work — ${meta.name}`}
  description="Three systems: a property search rebuilt around one canonical hierarchy, a multi-tenant legal-compliance backend, and the frontend of an Arabic answer engine."
>
  <div class="studio__nav u-shell--story">
    <WorldSwitch current="work" />
  </div>

  <div class="studio">
    <Studio artifacts={artifacts} notes={deskNotes} client:visible />
    <div class="studio__head u-shell--story">
      <h1 class="work__head">Under the lamp</h1>
      <p class="work__lede">
        Three systems I owned end to end. Drag to look, click to open.
      </p>
    </div>
  </div>

  <div class="work u-shell--story">
    <p class="work__indexlabel">Index</p>

    <ol class="work__list">
      {
        projects.map((project) => (
          <li class="entry">
            <a class="entry__link" href={`/work/${project.id}`} data-ev="index_used" data-ev-project={project.id}>
              <h2 class="entry__name">{project.name}</h2>
            </a>
            <p class="entry__proposition">{project.proposition}</p>
            <dl class="entry__meta">
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>{project.status}</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
</Story>

<style>
  .studio__nav {
    position: absolute;
    inset-inline: 0;
    z-index: 3;
    padding-top: var(--space-md);
  }

  .studio {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    cursor: grab;
  }

  .studio:active {
    cursor: grabbing;
  }

  .studio__head {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    padding-block: var(--space-lg) var(--space-md);
    pointer-events: none;
    background: linear-gradient(0deg, var(--ground) 8%, rgba(11, 11, 12, 0.72) 46%, transparent);
  }

  .studio__head .work__back {
    margin-bottom: var(--space-sm);
  }

  .studio__head .work__lede {
    max-width: 26rem;
    margin-bottom: 0;
  }

  .studio__head a {
    pointer-events: auto;
  }

  .work {
    padding-block: var(--space-lg) var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .work__indexlabel {
    font-family: var(--face-data);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: var(--space-md);
  }

  .work__back {
    display: inline-block;
    font-family: var(--face-meta);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: var(--space-xl);
  }

  .work__back:hover {
    color: var(--ink);
  }

  .work__head {
    font-size: clamp(1.9rem, 1.1rem + 2.4vw, 2.9rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm);
  }

  .work__lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    max-width: 34rem;
    margin-bottom: var(--space-xl);
  }

  .work__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .entry {
    border-top: 1px solid var(--line);
    padding-top: var(--space-sm);
    max-width: 46rem;
  }

  .entry__link {
    text-decoration: none;
  }

  .entry__name {
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.1rem);
    letter-spacing: -0.025em;
    margin-bottom: var(--space-2xs);
  }

  .entry__link:hover .entry__name {
    color: var(--accent);
  }

  .entry__proposition {
    color: var(--ink-muted);
    max-width: 36rem;
    margin-bottom: var(--space-sm);
  }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    font-family: var(--face-meta);
    font-size: var(--text-xs);
  }

  .entry__meta dt {
    color: var(--ink-muted);
    margin-bottom: 0.2rem;
  }

  .entry__meta dd {
    margin: 0;
  }
</style>
