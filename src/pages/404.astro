---
import Story from '../layouts/Story.astro';
import { meta } from '../content/meta';

/**
 * Not in either world, so it does not get the world switch: that component
 * marks one of the two as the current page, and here neither is. The two doors
 * below are the whole point of the page, so they carry the navigation alone.
 */
---

<Story world="gate" title={`Not found — ${meta.name}`} description="That door doesn’t open.">
  <main class="lost u-shell--story">
    <a class="lost__mark" href="/">{meta.name}</a>

    <div class="lost__body">
      <p class="lost__code">404</p>
      <h1 class="lost__head">That door doesn’t open.</h1>
      <p class="lost__say">Nothing lives at this address. The two that do are below.</p>

      <div class="lost__doors">
        <a href="/story">
          <span class="lost__door">The story</span>
          <span class="lost__gloss">Six years, a move to Dubai, and still no degree.</span>
        </a>
        <a href="/work">
          <span class="lost__door">The work</span>
          <span class="lost__gloss">Three systems, owned end to end.</span>
        </a>
      </div>
    </div>
  </main>
</Story>

<style>
  .lost {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-md) var(--space-xl);
  }

  .lost__mark {
    font-family: var(--face-data, var(--face-meta));
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .lost__mark:hover {
    color: var(--accent);
  }

  .lost__body {
    margin-block: auto;
    padding-block: var(--space-xl);
  }

  .lost__code {
    font-family: var(--face-data, var(--face-meta));
    font-size: var(--text-xs);
    color: var(--accent);
    margin: 0 0 var(--space-2xs);
  }

  .lost__head {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.6rem);
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin: 0 0 var(--space-xs);
  }

  .lost__say {
    color: var(--ink-muted);
    max-width: 34rem;
    margin-bottom: var(--space-lg);
  }

  .lost__doors {
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
    max-width: 46rem;
  }

  @media (min-width: 40rem) {
    .lost__doors {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lost__doors a {
    display: block;
    padding: var(--space-sm) var(--space-sm) var(--space-md);
    background: var(--ground);
    text-decoration: none;
    transition: filter 0.25s ease;
  }

  .lost__doors a:hover {
    filter: brightness(1.25);
  }

  .lost__door {
    display: block;
    font-size: var(--text-lg);
    color: var(--ink);
    margin-bottom: var(--space-2xs);
  }

  .lost__doors a:hover .lost__door {
    color: var(--accent);
  }

  .lost__gloss {
    display: block;
    font-family: var(--face-meta);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
</style>
