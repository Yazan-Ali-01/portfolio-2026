---
import { meta } from '../content/meta';

/**
 * The one piece of chrome on the site. Both worlds are always one click away,
 * from anywhere inside either of them.
 *
 * It takes no palette of its own: the tokens resolve per world, so this renders
 * rose-on-plum in the story and violet-on-black in the work without a branch.
 */

interface Props {
  current: 'story' | 'work' | 'ask';
  /** Appended after the world, for pages inside one — a case study name. */
  trail?: string;
}

const { current, trail } = Astro.props;
---

<nav class="worlds" aria-label="Sections">
  <a class="worlds__mark" href="/">{meta.name}</a>

  <span class="worlds__set">
    <a class="worlds__link" href="/story" aria-current={current === 'story' ? 'page' : undefined}>
      The story
    </a>
    <a class="worlds__link" href="/work" aria-current={current === 'work' ? 'page' : undefined}>
      The work
    </a>

    {/*
      Third, and marked, because it is the one people do not expect to be
      there. A link that reads the same as the other two gets scanned past;
      this one has to be noticed to be used at all.
    */}
    <a
      class="worlds__link worlds__link--ask"
      href="/ask"
      aria-current={current === 'ask' ? 'page' : undefined}
    >
      Ask
    </a>
  </span>

  {
    trail && (
      <span class="worlds__trail">
        <span aria-hidden="true">/</span> {trail}
      </span>
    )
  }
</nav>

<style>
  .worlds {
    /*
     * Named, so the browser carries this one element across a navigation
     * instead of crossfading it with the rest of the page. The chrome stays
     * put while the content changes underneath it, which is what makes moving
     * between the two worlds feel like one surface rather than two loads.
     */
    view-transition-name: worlds;

    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    /* --face-data only exists in the work world; the story falls back to Archivo. */
    font-family: var(--face-data, var(--face-meta));
    font-size: var(--text-xs);
  }

  .worlds__mark {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    /* 21px of text is under the 24px minimum for a standalone target. */
    padding-block: 0.2rem;
  }

  .worlds__mark:hover {
    color: var(--accent);
  }

  .worlds__set {
    display: flex;
    gap: var(--space-sm);
  }

  .worlds__link {
    color: var(--ink-muted);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease;
  }

  .worlds__link:hover {
    color: var(--ink);
  }

  .worlds__link[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /*
   * Carries a dot, so the eye lands on it. The other two are places on the
   * site and read as navigation; this one is a thing you can do, and it is
   * new enough that nobody is looking for it.
   */
  .worlds__link--ask {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    color: var(--ink);
  }

  .worlds__link--ask::before {
    content: '';
    width: 0.44em;
    height: 0.44em;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes worlds-ping {
      0%,
      70%,
      100% {
        opacity: 1;
      }
      85% {
        opacity: 0.25;
      }
    }

    .worlds__link--ask::before {
      animation: worlds-ping 3.5s ease-in-out infinite;
    }
  }

  .worlds__link--ask:hover {
    color: var(--accent);
  }

  .worlds__trail {
    color: var(--ink-faint);
  }
</style>
