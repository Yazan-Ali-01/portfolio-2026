---
import { meta } from '../content/meta';

/**
 * The end of the work world.
 *
 * The story world closes with a long pitch, earned after ten chapters. The work
 * side has to do the same job in four lines, because a reader who finishes a
 * case study is already convinced or already gone. Before this existed, the work
 * world had no contact path at all: case studies ended by linking to more case
 * studies.
 */

interface Props {
  /** Where the click came from, so the analytics can tell the two apart. */
  from: string;
}

const { from } = Astro.props;
---

<section class="close u-shell--story" id="contact">
  <p class="close__label">What I’m looking for</p>

  <p class="close__pitch">
    A senior role where I own a system end to end, and where the hard calls are mine to
    make. Remote anywhere, or on-site in Dubai. If that’s open on your team, email
    reaches me fastest.
  </p>

  <a
    class="close__mail"
    href={`mailto:${meta.email}`}
    data-ev="contact_click"
    data-ev-channel="email"
    data-ev-from={from}>{meta.email}</a
  >

  {/*
    A question box, not a link. Someone who has just read a case study has a
    question in their head; a link asks them to hold it while they navigate,
    and this one takes it straight there. Plain GET, so it works with no
    JavaScript and the resulting URL is shareable.
  */}
  <form class="close__ask" action="/ask" method="get">
    <label class="u-skip" for={`ask-${from}`}>Ask a question about Yazan</label>
    <input
      id={`ask-${from}`}
      class="close__askinput"
      name="q"
      placeholder="Ask anything about his work"
      autocomplete="off"
      maxlength="200"
    />
    <button class="close__askgo" type="submit" data-ev="contact_click" data-ev-channel="ask" data-ev-from={from}>
      Ask
    </button>
  </form>

  <p class="close__links">
    <a href={meta.linkedin} rel="me" data-ev="contact_click" data-ev-channel="linkedin" data-ev-from={from}>
      LinkedIn
    </a>
    <a href={meta.github} rel="me" data-ev="contact_click" data-ev-channel="github" data-ev-from={from}>
      GitHub
    </a>
  </p>
</section>

<style>
  .close {
    padding-block: var(--space-xl) var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .close__label {
    font-family: var(--face-data, var(--face-meta));
    font-size: var(--text-xs);
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .close__pitch {
    font-size: var(--text-lg);
    color: var(--ink);
    max-width: 38rem;
    margin-bottom: var(--space-lg);
  }

  /*
   * The address is the largest type on the page after the title. It is the one
   * thing this section exists to hand over.
   */
  .close__mail {
    display: inline-block;
    font-size: clamp(1.25rem, 0.8rem + 1.8vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.12em;
    transition: color 0.2s ease;
  }

  .close__mail:hover {
    color: var(--accent);
  }

  /* Matches the field on /ask, so arriving there feels like the same object. */
  .close__ask {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    max-width: 30rem;
    margin-bottom: var(--space-md);
    padding: 0 var(--space-xs) 0 var(--space-sm);
    background: var(--ground-raise);
    border: 1px solid #2f2f36;
    transition: border-color 0.15s ease;
  }

  .close__ask:hover {
    border-color: #3d3d46;
  }

  .close__ask:focus-within {
    border-color: var(--accent);
  }

  .close__askinput {
    flex: 1;
    min-height: 52px;
    background: transparent;
    border: 0;
    color: var(--ink);
    font-family: inherit;
    font-size: var(--text-base);
  }

  .close__askinput::placeholder {
    color: var(--ink-faint);
  }

  .close__askinput:focus-visible {
    outline: none;
  }

  .close__askgo {
    min-height: 40px;
    padding: 0 var(--space-sm);
    background: var(--accent);
    border: 0;
    color: var(--ground);
    font-family: var(--face-meta);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .close__links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
    margin-bottom: 0;
    font-family: var(--face-meta);
    font-size: var(--text-xs);
  }

  .close__links a {
    /* Standalone links, so they carry a target rather than just a line of text. */
    display: inline-block;
    padding-block: 0.2rem;
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .close__links a:hover {
    color: var(--ink);
    border-bottom-color: var(--line);
  }
</style>
